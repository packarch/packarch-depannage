<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Packarch</vendor>
  <vendor_url>https://github.com/packarch/packarch-depannage</vendor_url>

  <!-- Démarrer ou prolonger une session. Par défaut, le mot de passe d'un
       administrateur est demandé ; la règle 50-org.packarch.depannage.rules
       en dispense les administrateurs (groupe wheel) devant l'écran : le
       bouton « Autoriser le dépannage » vaut accord. Une action par commande
       (exec.argv1) : les autres commandes du programme ne sont pas couvertes. -->
  <action id="org.packarch.depannage.start">
    <description>Allow remote help</description>
    <description xml:lang="fr">Autoriser le dépannage à distance</description>
    <message>Authentication is required to give remote access to this computer</message>
    <message xml:lang="fr">Le mot de passe d'un administrateur est nécessaire pour donner un accès à distance à cet ordinateur</message>
    <icon_name>org.packarch.Depannage</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/packarch-depannage</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">start</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.packarch.depannage.extend">
    <description>Extend remote help</description>
    <description xml:lang="fr">Prolonger le dépannage à distance</description>
    <message>Authentication is required to extend the remote access to this computer</message>
    <message xml:lang="fr">Le mot de passe d'un administrateur est nécessaire pour prolonger l'accès à distance à cet ordinateur</message>
    <icon_name>org.packarch.Depannage</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/packarch-depannage</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">extend</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Arrêter une session : sans mot de passe pour l'utilisateur devant
       l'écran, quel qu'il soit -->
  <action id="org.packarch.depannage.stop">
    <description>Stop remote help</description>
    <description xml:lang="fr">Arrêter le dépannage à distance</description>
    <message>Stop the remote access to this computer</message>
    <message xml:lang="fr">Arrêter l'accès à distance à cet ordinateur</message>
    <icon_name>org.packarch.Depannage</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/packarch-depannage</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">stop</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
