[Unit]
Description=Fin d'une session de dépannage restée ouverte (Packarch)
Documentation=https://github.com/packarch/packarch-depannage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/packarch-depannage cleanup

[Install]
WantedBy=multi-user.target
